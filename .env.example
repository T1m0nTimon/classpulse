# ---- Required ----
# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- Address ----
# Public address students use (QR codes point here). Leave empty on a laptop: the app then
# shows the right network address automatically.
PUBLIC_URL=
# true when served over HTTPS (always on a public server)
SECURE_COOKIES=false

# ---- Database ----
# Default: a local SQLite file. For PostgreSQL (docker compose --profile prod) use:
# DATABASE_URL=postgresql+psycopg://classpulse:${POSTGRES_PASSWORD}@db:5432/classpulse
# empty = local SQLite file (classpulse.db, or /data/classpulse.db in Docker)
DATABASE_URL=
POSTGRES_PASSWORD=

# ---- Production with HTTPS (docker compose --profile prod) ----
DOMAIN=

# ---- Behaviour ----
ALLOW_REGISTRATION=true
SESSION_HOURS=12
DATA_RETENTION_DAYS=30
TEACHER_LOGIN_DAYS=14

# ---- Spotify (optional, see docs/spotify.md) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Optional AI moderation via an OpenAI-compatible endpoint (see docs/content-filter.md) ----
# Free + local example (Ollama):  AI_FILTER_URL=http://localhost:11434/v1/chat/completions  AI_FILTER_MODEL=llama3.2
AI_FILTER_URL=
AI_FILTER_MODEL=
AI_FILTER_API_KEY=
